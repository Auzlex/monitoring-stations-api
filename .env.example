PORT=7000
NODE_ENV=production
ENDPOINT_ADMIN_ACCESS_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_here

DB_USER=auzlex
DB_PASSWORD=your_db_password_here
DB_NAME=monitoring_db
DB_PORT=5435

# For local development (outside container) connecting to host port
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public

# CORS: set to your frontend domain in production, or * to allow all origins
CORS_ORIGIN=*
