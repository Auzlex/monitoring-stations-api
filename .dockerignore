# Dependencies — installed fresh inside the image
node_modules/

# TypeScript source — the image only needs the compiled dist/
# (Remove this line if your Dockerfile compiles inside the container, which ours does)

# Local environment files — secrets must NEVER be baked into an image
.env
.env.*
!.env.example

# Git internals
.git/
.gitignore

# Test files
test/
coverage/
*.lcov

# Editor / OS noise
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# pnpm debug
.pnpm-debug.log*
